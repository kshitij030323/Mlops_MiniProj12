# Copy to .env and edit:   cp .env.example .env
# Nothing environment-specific is hard-coded in the repository (D4). Every value below is injected at runtime.

# ---- Model provider (any OpenAI-compatible /chat/completions endpoint) ----
# Default: the local stub service (no key, no cost, deterministic, realistic delay). Used for load tests (D6).
LLM_BASE_URL=http://llm-stub:8090/v1
LLM_MODEL=stub-model
LLM_API_KEY=
# Optional: sent as reasoning_effort when set (Gemini thinking models: none | minimal | low)
LLM_REASONING_EFFORT=
# Real provider, free tier (examples; set your own spending limit first):
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=<model id from the provider console>
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=<model id>
#   Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1                      LLM_MODEL=<pulled model>
# Price per 1k tokens at call time, used for per-step cost attribution (L5). Example values only.
PRICE_PROMPT_PER_1K_USD=0.00059
PRICE_COMPLETION_PER_1K_USD=0.00079

# ---- Resilience (A5) ----
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
BREAKER_FAIL_THRESHOLD=3
BREAKER_RESET_S=30

# ---- Agent loop bounds (A1) ----
AGENT_MAX_STEPS=30
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_WALL_CLOCK_S=90
AGENT_MAX_VERIFY_ATTEMPTS=3
TOOL_TIMEOUT_S=5
RETRIEVAL_K=4
PROMPT_VARIANT=v2

# ---- Retrieval / index (L1, D2) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNKING_STRATEGY=clause

# ---- Internal endpoints (compose service names) ----
REDIS_URL=redis://redis:6379/0
VERIFIER_URL=http://verifier:8082
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---- Platform ----
WORKER_CONCURRENCY=4
RATE_LIMIT_PER_MIN=30
RUN_CACHE_TTL_S=3600
RETRIEVAL_CACHE_TTL_S=3600
RUN_DEADLINE_S=180
LIVE_EVAL_SAMPLE_RATE=0.2
# Enables options.demo_fault (self-verification demo). Keep false outside demonstrations.
DEMO_FAULTS_ENABLED=true

# ---- LLM stub ----
STUB_LATENCY_MS=1200
STUB_LATENCY_JITTER=0.3

# ---- Grafana admin (local only) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
