{
 "uid": "grievance",
 "title": "Grievance Routing Service",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Service (D5, D6)",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1
  },
  {
   "title": "Run latency end-to-end p50 / p95 (s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(run_duration_seconds_bucket[2m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(run_duration_seconds_bucket[2m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "30",
     "legendFormat": "SLO p95",
     "refId": "C"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 2
  },
  {
   "title": "Throughput (runs finished/s) by status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(runs_finished_total[2m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 3
  },
  {
   "title": "Error rate (failed+degraded runs / all; HTTP 5xx / all)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(runs_finished_total{status=~\"failed|degraded\"}[2m])) / clamp_min(sum(rate(runs_finished_total[2m])), 1e-9)",
     "legendFormat": "runs",
     "refId": "A"
    },
    {
     "expr": "sum(rate(http_requests_total{status=~\"5..\"}[2m])) / clamp_min(sum(rate(http_requests_total[2m])), 1e-9)",
     "legendFormat": "http",
     "refId": "B"
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "id": 4
  },
  {
   "title": "Availability (scrape up) by service",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "avg by (job) (up)",
     "legendFormat": "{{job}}",
     "refId": "A"
